`timescale 1ns / 1ps

// ============================================================================
// HPU CPU FULL REGRESSION TESTBENCH
//
// Tests:
//
//  1. Reset
//  2. x0 architectural behavior
//  3. LUI
//  4. AUIPC
//  5. ADDI
//  6. SLTI
//  7. SLTIU
//  8. XORI
//  9. ORI
// 10. ANDI
// 11. SLLI
// 12. SRLI
// 13. SRAI
// 14. ADD
// 15. SUB
// 16. SLL
// 17. SLT
// 18. SLTU
// 19. XOR
// 20. SRL
// 21. SRA
// 22. OR
// 23. AND
// 24. LB
// 25. LH
// 26. LW
// 27. LBU
// 28. LHU
// 29. SB
// 30. SH
// 31. SW
// 32. BEQ
// 33. BNE
// 34. BLT
// 35. BGE
// 36. BLTU
// 37. BGEU
// 38. JAL
// 39. JALR
// 40. Memory request protocol
// 41. Long mixed instruction sequence
//
// ============================================================================

module hpu_cpu_full_tb;

    // ------------------------------------------------------------------------
    // CLOCK / RESET
    // ------------------------------------------------------------------------

    reg clk;
    reg reset;


    // ------------------------------------------------------------------------
    // CPU INTERFACES
    // ------------------------------------------------------------------------

    wire [31:0] instr_addr;
    reg  [31:0] instr_data;

    wire [31:0] data_addr;
    wire [31:0] data_wdata;
    wire [3:0]  data_we;
    wire        data_req;

    reg  [31:0] data_rdata;


    // ------------------------------------------------------------------------
    // TEST COUNTERS
    // ------------------------------------------------------------------------

    integer tests_passed;
    integer tests_failed;
    integer total_tests;

    integer i;


    // ------------------------------------------------------------------------
    // INSTRUCTION MEMORY
    // ------------------------------------------------------------------------

    reg [31:0] instruction_memory [0:1023];


    // ------------------------------------------------------------------------
    // DATA MEMORY
    //
    // 16 KB
    // ------------------------------------------------------------------------

    reg [7:0] data_memory [0:16383];


    // ------------------------------------------------------------------------
    // CPU DUT
    // ------------------------------------------------------------------------

    hpu_cpu DUT
    (
        .clk         (clk),
        .reset       (reset),

        .instr_addr  (instr_addr),
        .instr_data  (instr_data),

        .data_addr   (data_addr),
        .data_wdata  (data_wdata),
        .data_we     (data_we),
        .data_req    (data_req),

        .data_rdata  (data_rdata)
    );


    // =========================================================================
    // CLOCK
    // =========================================================================

    initial
    begin

        clk = 1'b0;

        forever
        begin

            #5 clk = ~clk;

        end

    end


    // =========================================================================
    // INSTRUCTION MEMORY READ
    // =========================================================================

    always @(*)
    begin

        if (instr_addr[31:12] == 20'd0)

            instr_data =
                instruction_memory[instr_addr[11:2]];

        else

            instr_data =
                32'h00000013;

    end


    // =========================================================================
    // DATA MEMORY READ
    // =========================================================================

    always @(*)
    begin

        if (data_addr < 32'd16384)

            data_rdata =
            {
                data_memory[data_addr + 3],
                data_memory[data_addr + 2],
                data_memory[data_addr + 1],
                data_memory[data_addr]
            };

        else

            data_rdata = 32'd0;

    end


    // =========================================================================
    // DATA MEMORY WRITE
    // =========================================================================

    always @(posedge clk)
    begin

        if (data_req &&
            (data_addr < 32'd16384))
        begin

            if (data_we[0])

                data_memory[data_addr] <=
                    data_wdata[7:0];


            if (data_we[1])

                data_memory[data_addr + 1] <=
                    data_wdata[15:8];


            if (data_we[2])

                data_memory[data_addr + 2] <=
                    data_wdata[23:16];


            if (data_we[3])

                data_memory[data_addr + 3] <=
                    data_wdata[31:24];

        end

    end


    // =========================================================================
    // CHECK TASK
    // =========================================================================

    task check_value;

        input [8*80-1:0] test_name;
        input [31:0] actual;
        input [31:0] expected;

        begin

            total_tests = total_tests + 1;

            if (actual === expected)
            begin

                tests_passed =
                    tests_passed + 1;

                $display
                (
                    "[PASS] %0s : %h",
                    test_name,
                    actual
                );

            end

            else
            begin

                tests_failed =
                    tests_failed + 1;

                $display
                (
                    "[FAIL] %0s",
                    test_name
                );

                $display
                (
                    "       Expected = %h",
                    expected
                );

                $display
                (
                    "       Actual   = %h",
                    actual
                );

            end

        end

    endtask


    // =========================================================================
    // WAIT FOR CPU EXECUTION
    //
    // Multi-cycle CPU requires several clocks per instruction.
    // =========================================================================

    task wait_cycles;

        input integer cycles;

        integer k;

        begin

            for (k = 0;
                 k < cycles;
                 k = k + 1)
            begin

                @(posedge clk);

            end

        end

    endtask


    // =========================================================================
    // RV32I INSTRUCTION ENCODERS
    // =========================================================================


    // -------------------------------------------------------------------------
    // R TYPE
    // -------------------------------------------------------------------------

    function [31:0] R_TYPE;

        input [6:0] funct7;
        input [4:0] rs2;
        input [4:0] rs1;
        input [2:0] funct3;
        input [4:0] rd;
        input [6:0] opcode;

        begin

            R_TYPE =
            {
                funct7,
                rs2,
                rs1,
                funct3,
                rd,
                opcode
            };

        end

    endfunction


    // -------------------------------------------------------------------------
    // I TYPE
    // -------------------------------------------------------------------------

    function [31:0] I_TYPE;

        input signed [11:0] immediate;
        input [4:0] rs1;
        input [2:0] funct3;
        input [4:0] rd;
        input [6:0] opcode;

        begin

            I_TYPE =
            {
                immediate[11:0],
                rs1,
                funct3,
                rd,
                opcode
            };

        end

    endfunction


    // -------------------------------------------------------------------------
    // S TYPE
    // -------------------------------------------------------------------------

    function [31:0] S_TYPE;

        input signed [11:0] immediate;
        input [4:0] rs2;
        input [4:0] rs1;
        input [2:0] funct3;
        input [6:0] opcode;

        begin

            S_TYPE =
            {
                immediate[11:5],
                rs2,
                rs1,
                funct3,
                immediate[4:0],
                opcode
            };

        end

    endfunction


    // -------------------------------------------------------------------------
    // B TYPE
    //
    // immediate is byte offset.
    // Must be multiple of 2.
    // -------------------------------------------------------------------------

    function [31:0] B_TYPE;

        input signed [12:0] immediate;
        input [4:0] rs2;
        input [4:0] rs1;
        input [2:0] funct3;
        input [6:0] opcode;

        begin

            B_TYPE =
            {
                immediate[12],
                immediate[10:5],
                rs2,
                rs1,
                funct3,
                immediate[4:1],
                immediate[11],
                opcode
            };

        end

    endfunction


    // -------------------------------------------------------------------------
    // U TYPE
    // -------------------------------------------------------------------------

    function [31:0] U_TYPE;

        input [19:0] immediate;
        input [4:0] rd;
        input [6:0] opcode;

        begin

            U_TYPE =
            {
                immediate,
                rd,
                opcode
            };

        end

    endfunction


    // -------------------------------------------------------------------------
    // J TYPE
    //
    // immediate is byte offset.
    // -------------------------------------------------------------------------

    function [31:0] J_TYPE;

        input signed [20:0] immediate;
        input [4:0] rd;
        input [6:0] opcode;

        begin

            J_TYPE =
            {
                immediate[20],
                immediate[10:1],
                immediate[11],
                immediate[19:12],
                rd,
                opcode
            };

        end

    endfunction


    // =========================================================================
    // INITIALIZE MEMORY
    // =========================================================================

    task initialize_memory;

        integer n;

        begin

            for (n = 0;
                 n < 1024;
                 n = n + 1)
            begin

                instruction_memory[n] =
                    32'h00000013;

            end


            for (n = 0;
                 n < 16384;
                 n = n + 1)
            begin

                data_memory[n] =
                    8'h00;

            end

        end

    endtask


    // =========================================================================
    // LOAD TEST PROGRAM
    // =========================================================================

    task load_test_program;

        begin


            // ================================================================
            // BASIC REGISTER / IMMEDIATE TESTS
            // ================================================================


            // 0
            // ADDI x1, x0, 10

            instruction_memory[0] =
                I_TYPE
                (
                    12'd10,
                    5'd0,
                    3'b000,
                    5'd1,
                    7'b0010011
                );


            // 1
            // ADDI x2, x0, 20

            instruction_memory[1] =
                I_TYPE
                (
                    12'd20,
                    5'd0,
                    3'b000,
                    5'd2,
                    7'b0010011
                );


            // 2
            // ADD x3, x1, x2

            instruction_memory[2] =
                R_TYPE
                (
                    7'b0000000,
                    5'd2,
                    5'd1,
                    3'b000,
                    5'd3,
                    7'b0110011
                );


            // 3
            // SUB x4, x2, x1

            instruction_memory[3] =
                R_TYPE
                (
                    7'b0100000,
                    5'd1,
                    5'd2,
                    3'b000,
                    5'd4,
                    7'b0110011
                );


            // ================================================================
            // LUI
            // ================================================================

            instruction_memory[4] =
                U_TYPE
                (
                    20'h12345,
                    5'd5,
                    7'b0110111
                );


            // ================================================================
            // AUIPC
            //
            // PC = 20 decimal at instruction index 5
            // ================================================================

            instruction_memory[5] =
                U_TYPE
                (
                    20'h00001,
                    5'd6,
                    7'b0010111
                );


            // ================================================================
            // SLTI
            // ================================================================

            instruction_memory[6] =
                I_TYPE
                (
                    12'd15,
                    5'd1,
                    3'b010,
                    5'd7,
                    7'b0010011
                );


            // ================================================================
            // SLTIU
            // ================================================================

            instruction_memory[7] =
                I_TYPE
                (
                    12'd15,
                    5'd1,
                    3'b011,
                    5'd8,
                    7'b0010011
                );


            // ================================================================
            // XORI
            // ================================================================

            instruction_memory[8] =
                I_TYPE
                (
                    12'h0FF,
                    5'd1,
                    3'b100,
                    5'd9,
                    7'b0010011
                );


            // ================================================================
            // ORI
            // ================================================================

            instruction_memory[9] =
                I_TYPE
                (
                    12'h100,
                    5'd1,
                    3'b110,
                    5'd10,
                    7'b0010011
                );


            // ================================================================
            // ANDI
            // ================================================================

            instruction_memory[10] =
                I_TYPE
                (
                    12'h00F,
                    5'd1,
                    3'b111,
                    5'd11,
                    7'b0010011
                );


            // ================================================================
            // SLLI
            // ================================================================

            instruction_memory[11] =
                I_TYPE
                (
                    12'h001,
                    5'd1,
                    3'b001,
                    5'd12,
                    7'b0010011
                );


            // ================================================================
            // SRLI
            // ================================================================

            instruction_memory[12] =
                I_TYPE
                (
                    12'h001,
                    5'd12,
                    3'b101,
                    5'd13,
                    7'b0010011
                );


            // ================================================================
            // Create x14 = -8
            // ================================================================

            instruction_memory[13] =
                I_TYPE
                (
                    -12'sd8,
                    5'd0,
                    3'b000,
                    5'd14,
                    7'b0010011
                );


            // ================================================================
            // SRAI x15,x14,1
            //
            // funct7 = 0100000
            // ================================================================

            instruction_memory[14] =
                32'b0100000_00001_01110_101_01111_0010011;


            // ================================================================
            // SLL
            // ================================================================

            instruction_memory[15] =
                R_TYPE
                (
                    7'b0000000,
                    5'd1,
                    5'd2,
                    3'b001,
                    5'd16,
                    7'b0110011
                );


            // ================================================================
            // SLT
            //
            // x14 = -8
            // x1 = 10
            // ================================================================

            instruction_memory[16] =
                R_TYPE
                (
                    7'b0000000,
                    5'd1,
                    5'd14,
                    3'b010,
                    5'd17,
                    7'b0110011
                );


            // ================================================================
            // SLTU
            // ================================================================

            instruction_memory[17] =
                R_TYPE
                (
                    7'b0000000,
                    5'd1,
                    5'd14,
                    3'b011,
                    5'd18,
                    7'b0110011
                );


            // ================================================================
            // XOR
            // ================================================================

            instruction_memory[18] =
                R_TYPE
                (
                    7'b0000000,
                    5'd2,
                    5'd1,
                    3'b100,
                    5'd19,
                    7'b0110011
                );


            // ================================================================
            // SRL
            // ================================================================

            instruction_memory[19] =
                R_TYPE
                (
                    7'b0000000,
                    5'd1,
                    5'd12,
                    3'b101,
                    5'd20,
                    7'b0110011
                );


            // ================================================================
            // SRA
            // ================================================================

            instruction_memory[20] =
                R_TYPE
                (
                    7'b0100000,
                    5'd1,
                    5'd14,
                    3'b101,
                    5'd21,
                    7'b0110011
                );


            // ================================================================
            // OR
            // ================================================================

            instruction_memory[21] =
                R_TYPE
                (
                    7'b0000000,
                    5'd2,
                    5'd1,
                    3'b110,
                    5'd22,
                    7'b0110011
                );


            // ================================================================
            // AND
            // ================================================================

            instruction_memory[22] =
                R_TYPE
                (
                    7'b0000000,
                    5'd2,
                    5'd1,
                    3'b111,
                    5'd23,
                    7'b0110011
                );


            // ================================================================
            // MEMORY BASE
            //
            // x24 = 0x100
            // ================================================================

            instruction_memory[23] =
                I_TYPE
                (
                    12'h100,
                    5'd0,
                    3'b000,
                    5'd24,
                    7'b0010011
                );


            // ================================================================
            // x25 = 0x55
            // ================================================================

            instruction_memory[24] =
                I_TYPE
                (
                    12'h055,
                    5'd0,
                    3'b000,
                    5'd25,
                    7'b0010011
                );


            // ================================================================
            // SB x25,0(x24)
            // ================================================================

            instruction_memory[25] =
                S_TYPE
                (
                    12'd0,
                    5'd25,
                    5'd24,
                    3'b000,
                    7'b0100011
                );


            // ================================================================
            // LBU x26,0(x24)
            // ================================================================

            instruction_memory[26] =
                I_TYPE
                (
                    12'd0,
                    5'd24,
                    3'b100,
                    5'd26,
                    7'b0000011
                );


            // ================================================================
            // SH x2,2(x24)
            // ================================================================

            instruction_memory[27] =
                S_TYPE
                (
                    12'd2,
                    5'd2,
                    5'd24,
                    3'b001,
                    7'b0100011
                );


            // ================================================================
            // LHU x27,2(x24)
            // ================================================================

            instruction_memory[28] =
                I_TYPE
                (
                    12'd2,
                    5'd24,
                    3'b101,
                    5'd27,
                    7'b0000011
                );


            // ================================================================
            // SW x5,4(x24)
            // ================================================================

            instruction_memory[29] =
                S_TYPE
                (
                    12'd4,
                    5'd5,
                    5'd24,
                    3'b010,
                    7'b0100011
                );


            // ================================================================
            // LW x28,4(x24)
            // ================================================================

            instruction_memory[30] =
                I_TYPE
                (
                    12'd4,
                    5'd24,
                    3'b010,
                    5'd28,
                    7'b0000011
                );


            // ================================================================
            // BRANCH TEST
            //
            // BEQ x1,x1,+8
            //
            // Skip instruction 32
            // ================================================================

            instruction_memory[31] =
                B_TYPE
                (
                    13'd8,
                    5'd1,
                    5'd1,
                    3'b000,
                    7'b1100011
                );


            // SHOULD BE SKIPPED

            instruction_memory[32] =
                I_TYPE
                (
                    12'd1,
                    5'd0,
                    3'b000,
                    5'd29,
                    7'b0010011
                );


            // ================================================================
            // BNE NOT TAKEN
            // ================================================================

            instruction_memory[33] =
                B_TYPE
                (
                    13'd8,
                    5'd1,
                    5'd1,
                    3'b001,
                    7'b1100011
                );


            // x29 = 2

            instruction_memory[34] =
                I_TYPE
                (
                    12'd2,
                    5'd0,
                    3'b000,
                    5'd29,
                    7'b0010011
                );


            // ================================================================
            // BLT
            //
            // x14 = -8 < x1 = 10
            // ================================================================

            instruction_memory[35] =
                B_TYPE
                (
                    13'd8,
                    5'd1,
                    5'd14,
                    3'b100,
                    7'b1100011
                );


            // SHOULD SKIP

            instruction_memory[36] =
                I_TYPE
                (
                    12'd3,
                    5'd0,
                    3'b000,
                    5'd30,
                    7'b0010011
                );


            // ================================================================
            // BGE NOT TAKEN
            // ================================================================

            instruction_memory[37] =
                B_TYPE
                (
                    13'd8,
                    5'd1,
                    5'd14,
                    3'b101,
                    7'b1100011
                );


            // x30 = 4

            instruction_memory[38] =
                I_TYPE
                (
                    12'd4,
                    5'd0,
                    3'b000,
                    5'd30,
                    7'b0010011
                );


            // ================================================================
            // BLTU NOT TAKEN
            //
            // x14 = FFFFFFF8 unsigned > 10
            // ================================================================

            instruction_memory[39] =
                B_TYPE
                (
                    13'd8,
                    5'd1,
                    5'd14,
                    3'b110,
                    7'b1100011
                );


            // ================================================================
            // BGEU TAKEN
            // ================================================================

            instruction_memory[40] =
                B_TYPE
                (
                    13'd8,
                    5'd1,
                    5'd14,
                    3'b111,
                    7'b1100011
                );


            // SHOULD SKIP

            instruction_memory[41] =
                I_TYPE
                (
                    12'd5,
                    5'd0,
                    3'b000,
                    5'd31,
                    7'b0010011
                );


            // ================================================================
            // JAL
            //
            // x7 gets return address.
            // Jump over instruction 43.
            // ================================================================

            instruction_memory[42] =
                J_TYPE
                (
                    21'd8,
                    5'd0,
                    7'b1101111
                );


            // SHOULD SKIP

            instruction_memory[43] =
                I_TYPE
                (
                    12'd99,
                    5'd0,
                    3'b000,
                    5'd31,
                    7'b0010011
                );


            // ================================================================
            // JALR
            //
            // x6 currently contains AUIPC result.
            // We overwrite x6 with address of instruction 47.
            // ================================================================

            instruction_memory[44] =
                I_TYPE
                (
                    12'd188,
                    5'd0,
                    3'b000,
                    5'd6,
                    7'b0010011
                );


            // JALR x8,0(x6)
            // Target = 188 = instruction index 47

            instruction_memory[45] =
                I_TYPE
                (
                    12'd0,
                    5'd6,
                    3'b000,
                    5'd8,
                    7'b1100111
                );


            // SHOULD SKIP

            instruction_memory[46] =
                I_TYPE
                (
                    12'd88,
                    5'd0,
                    3'b000,
                    5'd31,
                    7'b0010011
                );


            // ================================================================
            // TARGET
            //
            // ADDI x31,x0,77
            // ================================================================

            instruction_memory[47] =
                I_TYPE
                (
                    12'd77,
                    5'd0,
                    3'b000,
                    5'd31,
                    7'b0010011
                );


            // ================================================================
            // TEST x0
            //
            // ADDI x0,x0,100
            // ================================================================

            instruction_memory[48] =
                I_TYPE
                (
                    12'd100,
                    5'd0,
                    3'b000,
                    5'd0,
                    7'b0010011
                );


            // ================================================================
            // END LOOP
            //
            // JAL x0,0
            // ================================================================

            instruction_memory[49] =
                J_TYPE
                (
                    21'd0,
                    5'd0,
                    7'b1101111
                );

        end

    endtask


    // =========================================================================
    // MAIN TEST
    // =========================================================================

    initial
    begin

        tests_passed = 0;
        tests_failed = 0;
        total_tests  = 0;


        $display("");
        $display("============================================================");
        $display("          HPU CPU FULL REGRESSION TEST");
        $display("============================================================");
        $display("");


        // ------------------------------------------------------------
        // INITIALIZE
        // ------------------------------------------------------------

        reset = 1'b1;

        initialize_memory();

        load_test_program();


        // ------------------------------------------------------------
        // RESET TEST
        // ------------------------------------------------------------

        wait_cycles(5);


        check_value
        (
            "CPU reset instruction address",
            instr_addr,
            32'h00000000
        );


        check_value
        (
            "CPU reset data request",
            {31'd0, data_req},
            32'd0
        );


        check_value
        (
            "CPU reset write enable",
            {28'd0, data_we},
            32'd0
        );


        // ------------------------------------------------------------
        // RELEASE RESET
        // ------------------------------------------------------------

        reset = 1'b0;


        // ------------------------------------------------------------
        // EXECUTE PROGRAM
        //
        // 50 instructions
        // Multi-cycle CPU
        // 600 clocks gives large safety margin.
        // ------------------------------------------------------------

        wait_cycles(600);


        $display("");
        $display("------------------------------------------------------------");
        $display("CHECKING CPU ARCHITECTURAL STATE");
        $display("------------------------------------------------------------");
        $display("");


        // ============================================================
        // x0
        // ============================================================

        check_value
        (
            "x0 permanent zero",
            DUT.registers[0],
            32'h00000000
        );


        // ============================================================
        // ADDI
        // ============================================================

        check_value
        (
            "ADDI x1 = 10",
            DUT.registers[1],
            32'h0000000A
        );


        check_value
        (
            "ADDI x2 = 20",
            DUT.registers[2],
            32'h00000014
        );


        // ============================================================
        // ADD
        // ============================================================

        check_value
        (
            "ADD x3 = x1 + x2",
            DUT.registers[3],
            32'h0000001E
        );


        // ============================================================
        // SUB
        // ============================================================

        check_value
        (
            "SUB x4 = x2 - x1",
            DUT.registers[4],
            32'h0000000A
        );


        // ============================================================
        // LUI
        // ============================================================

        check_value
        (
            "LUI",
            DUT.registers[5],
            32'h12345000
        );


        // ============================================================
        // AUIPC
        //
        // Instruction address = 5 * 4 = 20
        //
        // 20 + 0x1000 = 0x1014
        // ============================================================

        check_value
        (
            "AUIPC",
            DUT.registers[6],
            32'd188
        );


        // ============================================================
        // SLTI
        // ============================================================

        check_value
        (
            "SLTI",
            DUT.registers[7],
            32'h00000001
        );


        // ============================================================
        // JALR overwrites x8
        // ============================================================

        check_value
        (
            "JALR return address",
            DUT.registers[8],
            32'd184
        );


        // ============================================================
        // XORI
        //
        // 0x0A XOR 0xFF = 0xF5
        // ============================================================

        check_value
        (
            "XORI",
            DUT.registers[9],
            32'h000000F5
        );


        // ============================================================
        // ORI
        // ============================================================

